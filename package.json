{
  "name": "project-game-community",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PROJECT — игровое сообщество на Cloudflare Pages, Workers и D1.",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:cloudflare": "wrangler pages dev --local --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler pages deploy",
    "check:js": "node scripts/check-js.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check": "node scripts/check-js.mjs && node scripts/check-assets.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.57.0",
    "wrangler": "4.165.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
